$access_token = $_SESSION['fb_access_token'];
}
$appId         = '1930491627191257'; //Facebook App ID
$appSecret     = '934f83f24436ea82749ca6b5fafc6281'; //Facebook App Secret
$fb = new Facebook\Facebook([
  'app_id'                => $appId,
